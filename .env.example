# Public production origin used by metadata, canonical URLs, sitemap and schema.
NEXT_PUBLIC_SITE_URL=https://brandspaces.in

# Optional Cloudflare Turnstile. The site key is public; keep the secret only
# in Vercel / deployment environment variables.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact delivery. Configure Resend OR a trusted webhook in production.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=brandspace.contact@gmail.com
CONTACT_WEBHOOK_URL=

# Optional serverless-distributed contact rate limiting. If omitted, the API
# falls back to a best-effort in-memory limiter while Turnstile remains active.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
