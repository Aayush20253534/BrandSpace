{
  "name": "brandspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "assets:logo": "node scripts/process-logo.mjs",
    "assets:portfolio": "node scripts/process-portfolio.mjs",
    "assets:og": "node scripts/generate-og.mjs",
    "growth-city:frames": "node scripts/growth-city-frames.mjs",
    "perf:check": "node scripts/performance-check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "check": "npm run lint && npm run typecheck && npm run perf:check && npm run security:check && npm run build",
    "audit:security": "npm audit --audit-level=high",
    "release:source": "node scripts/release-verify.mjs",
    "release:verify": "npm run check && npm run audit:security && npm run release:source",
    "release:check:live": "node scripts/release-live-check.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "marked": "^18.0.14",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
